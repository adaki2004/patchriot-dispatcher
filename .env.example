# Local dispatcher configuration. Copy to .env, chmod 600 .env, fill required values,
# then load it with: set -a; . ./.env; set +a
# The binary does not load .env automatically. Never commit the filled file.
# Inference keys belong to the relay's private key files, not this service.
# Model selection below tells the scheduler which configured agents to choose.

# REQUIRED: a separate PostgreSQL 17 database for DISPATCHER ONLY.
# Example shape: postgresql://USER:PASSWORD@127.0.0.1:5432/patchriot_dispatcher
DATABASE_URL=
# REQUIRED: the SAME generated service secret used by core (openssl rand -hex 32).
# This grants internal service access; keep it out of the agent-only gateway environment.
PATCHRIOT_INTERNAL_KEY=
# REQUIRED: stable signature audience; use exactly this value when initializing relays.
# Choose a different value for each independent deployment; changing it breaks existing pairing.
PATCHRIOT_AUDIENCE=patchriot-local-v1
# Internal listener. Keep private; agents need only the separate gateway outside local testing.
PATCHRIOT_BIND=127.0.0.1:7411
# Optional second listener for an agent-only HTTPS/Tailscale reverse proxy.
# If set, both listeners must bind to distinct nonzero loopback ports.
# PATCHRIOT_RELAY_BIND=127.0.0.1:7412

# Per-role ceiling in seconds, 600 by default, maximum 10800. This is not a target duration.
PATCHRIOT_AGENT_ATTEMPT_SECONDS=600
# Simultaneous roles per operator/machine: 1..4, default 1. Use the SAME value on the gateway.
PATCHRIOT_COMPUTE_GROUP_CONCURRENCY=1
# New website permission records per requester in 24 hours: 1..100, default 10.
PATCHRIOT_LIVE_REQUESTS_PER_DAY=10
# Unfinished reviews per requester, including waiting reservations: 1..30, default 3.
PATCHRIOT_LIVE_REVIEWS_PER_REQUESTER=3

# Needed for grey-box and perimeter credentials: generate independently with openssl rand -hex 32.
# Keep this stable and back it up separately. Losing it makes saved credentials unreadable.
# Same key on dispatcher and its agent-only gateway. Do not rotate while credentials remain stored.
# PATCHRIOT_CREDENTIAL_KEY=
# Optional server-side OpenRouter key for screening nonempty extra testing context.
# Without it, leave extra context empty; screening never grants broader scope.
# PATCHRIOT_JEV_OPENROUTER_KEY=

# Optional primary/backup selection for NEW requests. Configure approved relay devices with
# matching models and their private provider keys first. Leave BOTH unset for no global preference.
# Choose either direction, using these exact supported names:
# NEAR: deepseek-ai/DeepSeek-V4.1-Flash-1017-abliterated
# Venice: deepseek-v4-1-flash-1017-uncensored
# Local guide: NEAR first, Venice backup. Uncomment BOTH after configuring the relays.
# PATCHRIOT_INFERENCE_PRIMARY_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017-abliterated
# PATCHRIOT_INFERENCE_SECONDARY_MODEL=deepseek-v4-1-flash-1017-uncensored
# Alternatively select between both ready provider pools; false by default.
# Requires two approved agents per available pool reporting the reciprocal backup.
# Keep primary, secondary and the legacy flag unset/false when enabling this.
PATCHRIOT_INFERENCE_BALANCED_POOLS=false
# Legacy setting only. Keep false with the primary/secondary settings above.
PATCHRIOT_VENICE_FALLBACK_ENABLED=false

# Optional legacy admin-only development allowlist; exact authorized HTTPS origins, no paths/wildcards.
# The back-office ownership approval instead records permission and reason per request.
# PATCHRIOT_OWNED_TEST_ORIGINS='["https://staging.example.com"]'
# Retired summary checker only. Leave unset; this is NOT the relay's NEAR inference key.
# PATCHRIOT_NEAR_AI_KEY=

# Separate gateway binary only: no INTERNAL_KEY. Needs DATABASE_URL, AUDIENCE,
# CREDENTIAL_KEY, AGENT_ATTEMPT_SECONDS and COMPUTE_GROUP_CONCURRENCY as above.
# PATCHRIOT_GATEWAY_BIND=127.0.0.1:7412
# Tests only: dedicated disposable database, never production.
# PATCHRIOT_TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/patchriot_tests
